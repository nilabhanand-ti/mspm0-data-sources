            <fields>
              <field>
                <name>SIZE</name>
                <description>DMA Channel Size in number of transfers</description>
                <bitOffset>0</bitOffset>
                <bitWidth>16</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MINIMUM</name>
                    <description>Smallest value</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>MAXIMUM</name>
                    <description>Highest possible value</description>
                    <value>0xFFFF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
        </cluster>
      </registers>
