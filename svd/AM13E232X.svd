              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>IEL_RSVD</name>
                  <description>Reserved</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEL_POSRISING</name>
                  <description>Latches position counter on rising edge of the index signal</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEL_POSFALLING</name>
                  <description>Latches position counter on falling edge of the index signal</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>IEL_SIM</name>
                  <description>Software index marker. Latches the position counter and quadrature direction flag on index event marker. The position counter is latched to the QPOSILAT register and the direction flag is latched in the QEPSTS[QDLF] bit. This mode is useful for software index marking.</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SEL</name>
              <description>Strobe event latch</description>
