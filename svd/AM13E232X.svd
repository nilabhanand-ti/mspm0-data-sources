    <peripheral>
      <name>NVMNW</name>
      <groupName>NVMNW</groupName>
      <description>NVMNW module</description>
      <baseAddress>0x40042000</baseAddress>
      <addressBlock>
        <offset>0x0</offset>
        <size>0x1500</size>
        <usage>registers</usage>
      </addressBlock>
      <registers>
        <register>
          <name>CPU_CONNECT_0</name>
          <description>CPU Connect</description>
          <addressOffset>0x480</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CPUSS0_CONN</name>
              <description>CPUSS0 connect bit.</description>
              <bitOffset>1</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>UNCONNECTED</name>
                  <description>The CPU is not connected.</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CONNECTED</name>
                  <description>The CPU is connected.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IIDX</name>
          <description>Interrupt Index Register</description>
          <addressOffset>0x1020</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>STAT</name>
              <description>Indicates which interrupt has fired. 0x0 means no event pending. The priority order is fixed. On each read, only one interrupt is indicated. On a read, the current interrupt (highest priority) is automatically cleared by the hardware and the corresponding interrupt flags in the RIS and MIS are cleared as well. After a read from the CPU (not from the debug interface), the register must be updated with the next highest priority interrupt.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_INTR</name>
                  <description>No Interrupt Pending</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DONE</name>
                  <description>DONE Interrupt Pending</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>IMASK</name>
          <description>Interrupt Mask Register</description>
          <addressOffset>0x1028</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DONE</name>
              <description>Interrupt mask for DONE: 0: Interrupt is disabled in MIS register 1: Interrupt is enabled in MIS register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>Interrupt is masked out</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>Interrupt will request an interrupt service routine and corresponding bit in [IPSTANDARD.MIS] will be set</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RIS</name>
          <description>Raw Interrupt Status Register</description>
          <addressOffset>0x1030</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DONE</name>
              <description>Flash wrapper operation completed.  This interrupt bit is set by firmware or the corresponding bit in the ISET register.  It is cleared by the corresponding bit in in the ICLR register or reading the IIDX register when this interrupt is the highest priority.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLR</name>
                  <description>Interrupt did not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET</name>
                  <description>Interrupt occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MIS</name>
          <description>Masked Interrupt Status Register</description>
          <addressOffset>0x1038</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DONE</name>
              <description>Flash wrapper operation completed.  This masked interrupt bit reflects the bitwise AND of the corresponding RIS and IMASK bits.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLR</name>
                  <description>Masked interrupt did not occur</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET</name>
                  <description>Masked interrupt occurred</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ISET</name>
          <description>Interrupt Set Register</description>
          <addressOffset>0x1040</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DONE</name>
              <description>0: No effect 1: Set the DONE interrupt in the RIS register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Writing a 0 has no effect</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SET</name>
                  <description>Set [IPSTANDARD.RIS] bit</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>ICLR</name>
          <description>Interrupt Clear Register</description>
          <addressOffset>0x1048</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DONE</name>
              <description>0: No effect 1: Clear the DONE interrupt in the RIS register</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NO_EFFECT</name>
                  <description>Writing a 0 has no effect</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLR</name>
                  <description>Clear [IPSTANDARD.RIS] bit</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CMDEXEC</name>
          <description>Command Execute Register</description>
          <addressOffset>0x1100</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Command Execute value Initiates execution of the command specified in the CMDTYPE register.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOEXECUTE</name>
                  <description>Command will not execute or is not executing in flash wrapper</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>EXECUTE</name>
                  <description>Command will execute or is executing in flash wrapper</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CMDTYPE</name>
          <description>Command Type Register</description>
          <addressOffset>0x1104</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>COMMAND</name>
              <description>Command type</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOOP</name>
                  <description>No Operation</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PROGRAM</name>
                  <description>Program</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ERASE</name>
                  <description>Erase</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>READVERIFY__SECRET_ENUM</name>
                  <description>ReadVerify - Perform a standalone ReadVerify operation.</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MODECHANGE</name>
                  <description>Mode Change - Perform a mode change only, no other operation.</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLEARSTATUS</name>
                  <description>Clear Status - Clear status bits in FW_SMSTAT only.</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BLANKVERIFY</name>
                  <description>Blank Verify - Check whether a flash word is in the erased state. This command may only be used with CMDTYPE.SIZE = ONEWORD</description>
                  <value>0x6</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SIZE</name>
              <description>Command size</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>ONEWORD</name>
                  <description>Operate on 1 flash word</description>
