                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCU3</name>
                    <description>Selects CCU from CC3.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCU4</name>
                    <description>Selects CCU from CC4.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCU5</name>
                    <description>Selects CCU from CC5.</description>
                    <value>0x5</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>CC2SELD</name>
