          <addressOffset>0x1210</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>VAL</name>
              <description>Each bit protects 1 sector.  bit [0]: When 1, sector 0 of the non-main region will be protected from program   and erase. bit [1]: When 1, sector 1 of the non-main region will be protected from program   and erase.  :  : bit [31]: When 1, sector 31 of the non-main will be protected from program   and erase.</description>
              <bitOffset>0</bitOffset>
