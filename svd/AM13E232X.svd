                    <description>Inputs 0 to connected core</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INP_ENABLE</name>
                    <description>Inputs IO pad value to connected core</description>
                    <value>0x1</value>
