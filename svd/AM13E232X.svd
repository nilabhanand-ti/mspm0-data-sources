                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0xCE</value>
                </enumeratedValue>
              </enumeratedValues>
