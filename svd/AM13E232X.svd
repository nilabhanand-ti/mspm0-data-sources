            <description>GPIO1 pin 8 functional input signal from external pad to crossbar peripheral</description>
            <addressOffset>0xA0</addressOffset>
            <size>32</size>
            <fields>
              <field>
                <name>PSTATE</name>
                <description>Peripheral-Analog Channel State</description>
                <bitOffset>6</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNASSIGNED</name>
                    <description>P-Channel is in Unassigned State</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HANDOVER</name>
                    <description>P-Channel is in Handover State</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_NOT_LOCKED</name>
                    <description>P-Channel is in Connected State and not Locked (That is F field is allowed to change without going back through Unassigned state)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_LOCKED</name>
                    <description>P-Channel is in Connected State and Locked (That is F field is not allowed to change to a different non-Zero value until both G and P channels go to Unassigned)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GSTATE</name>
                <description>GPIO Channel State</description>
