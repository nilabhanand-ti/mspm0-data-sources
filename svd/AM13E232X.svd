                  <description>CLK_OUT is LFCLK</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MFPCLK</name>
                  <description>CLK_OUT is MFPCLK (EXCLKDIVEN must be enabled)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFCLK</name>
                  <description>CLK_OUT is HFCLK</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSPLLOUT1</name>
                  <description>CLK_OUT is SYSPLLCLK1 (SYSPLLCLK1 must be &lt;=48MHz)</description>
                  <value>0x5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXCLKDIVVAL</name>
              <description>EXCLKDIVVAL selects the divider value for the divider in the CLK_OUT external clock output block.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DIV2</name>
                  <description>CLK_OUT source is divided by 2</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV4</name>
                  <description>CLK_OUT source is divided by 4</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV6</name>
                  <description>CLK_OUT source is divided by 6</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV8</name>
                  <description>CLK_OUT source is divided by 8</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV10</name>
                  <description>CLK_OUT source is divided by 10</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV12</name>
                  <description>CLK_OUT source is divided by 12</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV14</name>
                  <description>CLK_OUT source is divided by 14</description>
                  <value>0x6</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DIV16</name>
                  <description>CLK_OUT source is divided by 16</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>EXCLKDIVEN</name>
              <description>EXCLKDIVEN enables or disables the divider function of the CLK_OUT external clock output block.</description>
              <bitOffset>7</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>PASSTHRU</name>
                  <description>CLock divider is disabled (passthrough, EXCLKDIVVAL is not applied)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Clock divider is enabled (EXCLKDIVVAL is applied)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>PMODECFG</name>
          <description>Power mode configuration</description>
          <addressOffset>0x1144</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DSLEEP</name>
              <description>DSLEEP selects the operating mode to enter upon a DEEPSLEEP request from the CPU.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>STOP</name>
                  <description>STOP mode is entered</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>STANDBY</name>
                  <description>STANDBY mode is entered</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SHUTDOWN</name>
                  <description>SHUTDOWN mode is entered</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RESERVED</name>
                  <description>Reserved</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MLDOLPENCFG</name>
          <description>LDO Configuration Control</description>
          <addressOffset>0x1148</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>CVLODIS</name>
              <description>Control to disable lowering the core voltage for STOP and STANDBY</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>Lower Core Voltage for STOP and STANDBY mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Do Not Lower Core Voltage for STOP and STANDBY mode to provide faster wakeup</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>FCC</name>
          <description>Frequency clock counter (FCC) count</description>
          <addressOffset>0x1150</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DATA</name>
              <description>Frequency clock counter (FCC) count value.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>22</bitWidth>
              <access>read-only</access>
            </field>
          </fields>
        </register>
        <register>
          <name>PMULDOSPARECTL</name>
          <description>LDO Spare Control</description>
          <addressOffset>0x1154</addressOffset>
          <size>32</size>
        </register>
        <register>
          <name>SYSCTL_ECO_REG1</name>
          <description>Sysctl ECO Reg 1</description>
          <addressOffset>0x1158</addressOffset>
          <size>32</size>
        </register>
        <register>
          <name>SYSCTL_ECO_REG2</name>
          <description>Sysctl ECO Reg 2</description>
          <addressOffset>0x115C</addressOffset>
          <size>32</size>
        </register>
        <register>
          <name>SYSTEMCFG</name>
          <description>System configuration</description>
          <addressOffset>0x1180</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>FLASHECCRSTDIS</name>
              <description>FLASHECCRSTDIS specifies whether a flash ECC double error detect (DED) will trigger a SYSRST or an NMI.</description>
              <bitOffset>2</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>Flash ECC DED will trigger a SYSRST</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Flash ECC DED will trigger a NMI</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>WWDTLP0RSTDIS</name>
              <description>WWDTLP0RSTDIS specifies whether a WWDT Error Event will trigger a BOOTRST or an NMI.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>WWDTLP0 Error Event will trigger a BOOTRST</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>WWDTLP0 Error Event will trigger an NMI</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0x1B</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SRAMCFG</name>
          <description>System SRAM configuration</description>
          <addressOffset>0x1184</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>BANKINITDIS3</name>
              <description>SRAM BANK3 Initialization</description>
              <bitOffset>19</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK3 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK3 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BANKINITDIS2</name>
              <description>SRAM BANK2 Initialization</description>
              <bitOffset>18</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK2 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK2 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BANKINITDIS5</name>
              <description>SRAM BANK5 Initialization</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK5 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK5 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BANKINITDIS0</name>
              <description>SRAM BANK0 Initialization</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK0 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK0 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BANKINITDIS4</name>
              <description>SRAM BANK4 Initialization</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK4 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK4 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BANKINITDIS1</name>
              <description>SRAM BANK1 Initialization</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SRAM BANK1 will Initialize when transitioning from OFF to ON</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SRAM BANK1 will NOT Initialize when transitioning from OFF to ON</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0xB5</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>WRITELOCK</name>
          <description>SYSCTL register write lockout</description>
          <addressOffset>0x1200</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>ACTIVE</name>
              <description>ACTIVE controls whether critical SYSCTL registers are write protected or not.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Allow writes to lockable registers</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Disallow writes to lockable registers</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>CLKSTATUS</name>
          <description>Clock module (CKM) status</description>
          <addressOffset>0x1204</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>LFOSCGOOD</name>
              <description>LFOSCGOOD indicates when the LFOSC startup has completed and the LFOSC is ready for use.</description>
              <bitOffset>11</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>LFOSC is not ready</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>LFOSC is ready</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HFCLKGOOD</name>
              <description>HFCLKGOOD indicates that the HFCLK started correctly.  When the XTAL is started or HFCLK_IN is selected as the HFCLK source,  this bit will be set by hardware if a valid HFCLK is detected, and cleared if HFCLK is not operating within the expected range.</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>HFCLK did not start correctly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>HFCLK started correctly</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSCLKDEAD</name>
              <description>HSCLKDEAD is set by hardware if the selected source for HSCLK was started but did not start successfully.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>The HSCLK source was not started or started correctly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>The HSCLK source did not start correctly</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSPLLBLKUPD</name>
              <description>SYSPLLBLKUPD indicates when writes to SYSPLLCFG0/1 and SYSPLLPARAM0/1 are blocked.</description>
              <bitOffset>29</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>writes to SYSPLLCFG0/1 and SYSPLLPARAM0/1 are allowed</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>writes to SYSPLLCFG0/1 and SYSPLLPARAM0/1 are blocked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HFCLKOFF</name>
              <description>HFCLKOFF indicates if the HFCLK is disabled or was dead at startup.  When the HFCLK is started, HFCLKOFF is cleared by hardware.  Following startup of the HFCLK, if the HFCLK startup monitor determines that the HFCLK was not started correctly, HFCLKOFF is set.</description>
              <bitOffset>13</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>HFCLK started correctly and is enabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>HFCLK is disabled or was dead at startup</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HFCLKBLKUPD</name>
              <description>HFCLKBLKUPD indicates when writes to the HFCLKCLKCFG register are blocked.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>Writes to HFCLKCLKCFG are allowed</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Writes to HFCLKCLKCFG are blocked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSCLKGOOD</name>
              <description>HSCLKGOOD is set by hardware if the selected clock source for HSCLK started successfully.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>The HSCLK source did not start correctly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>The HSCLK source started correctly</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSPLLGOOD</name>
              <description>SYSPLLGOOD indicates if the SYSPLL started correctly.  When the SYSPLL is started, SYSPLLGOOD is cleared by hardware.  After the startup settling time has expired, the SYSPLL status is tested.  If the SYSPLL started successfully the SYSPLLGOOD bit is set, else it is left cleared.</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SYSPLL did not start correctly</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SYSPLL started correctly</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSCLKMUX</name>
              <description>HSCLKMUX indicates if MCLK is currently sourced from the high-speed clock (HSCLK).</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSOSC</name>
                  <description>MCLK is not sourced from HSCLK</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HSCLK</name>
                  <description>MCLK is sourced from HSCLK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSOSCFREQ</name>
              <description>SYSOSCFREQ indicates the current SYSOSC operating frequency.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSOSC32M</name>
                  <description>SYSOSC is at base frequency (32MHz)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSOSC4M</name>
                  <description>SYSOSC is at low frequency (4MHz)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HSCLKSOFF</name>
              <description>HSCLKSOFF is set when the high speed clock sources (SYSPLL, HFCLK) are disabled or dead.  It is the logical AND of HFCLKOFF and SYSPLLOFF.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SYSPLL, HFCLK, or both were started correctly and remain enabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SYSPLL and HFCLK are both either off or dead</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FCLMODE</name>
              <description>FCLMODE indicates if the SYSOSC frequency correction loop (FCL) is enabled.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLED</name>
                  <description>SYSOSC FCL is disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLED</name>
                  <description>SYSOSC FCL is enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CURHSCLKSEL</name>
              <description>CURHSCLKSEL indicates the current clock source for HSCLK.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSPLL</name>
                  <description>HSCLK is currently sourced from the SYSPLL</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFCLK</name>
                  <description>HSCLK is currently sourced from the HFCLK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FCCDONE</name>
              <description>FCCDONE indicates when a frequency clock counter capture is complete.</description>
              <bitOffset>25</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NOTDONE</name>
                  <description>FCC capture is not done</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>DONE</name>
                  <description>FCC capture is done</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSPLLOFF</name>
              <description>SYSPLLOFF indicates if the SYSPLL is disabled or was dead at startup.  When the SYSPLL is started, SYSPLLOFF is cleared by hardware.  Following startup of the SYSPLL, if the SYSPLL startup monitor determines that the SYSPLL was not started correctly, SYSPLLOFF is set.</description>
              <bitOffset>14</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>SYSPLL started correctly and is enabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>SYSPLL is disabled or was dead startup</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
