                  <description>Do nothing (action disabled)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SWI_INITPOS</name>
                  <description>Initialize position counter (QPOSCNT=QPOSINIT). This bit is not cleared automatically</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
