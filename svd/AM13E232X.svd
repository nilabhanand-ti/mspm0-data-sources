          <fields>
            <field>
              <name>MODESEL</name>
              <description>Mode  This field is only used for the Mode Change command type.  Otherwise, bank  and pump modes are set automaticlly through the NW hardware.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
