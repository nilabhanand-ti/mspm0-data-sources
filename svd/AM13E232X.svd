          <register>
            <name>PWM1A_OUTPUT</name>
            <description>PWM1A output interface (fout=data, foe=output enable)</description>
            <addressOffset>0x0</addressOffset>
            <size>32</size>
            <fields>
              <field>
                <name>PSTATE</name>
                <description>Peripheral-Analog Channel State</description>
                <bitOffset>6</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNASSIGNED</name>
                    <description>P-Channel is in Unassigned State</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HANDOVER</name>
                    <description>P-Channel is in Handover State</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_NOT_LOCKED</name>
                    <description>P-Channel is in Connected State and not Locked (That is F field is allowed to change without going back through Unassigned state)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_LOCKED</name>
                    <description>P-Channel is in Connected State and Locked (That is F field is not allowed to change to a different non-Zero value until both G and P channels go to Unassigned)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>GSTATE</name>
                <description>GPIO Channel State</description>
                <bitOffset>14</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNASSIGNED</name>
                    <description>G-Channel is in Unassigned State</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HANDOVER</name>
                    <description>G-Channel is in Handover State</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_NOT_LOCKED</name>
                    <description>G-Channel is in Connected State and not Locked (That is F field is allowed to change without going back through Unassigned state)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>CONC_LOCKED</name>
                    <description>G-Channel is in Connected State and Locked (That is F field is not allowed to change to a different non-Zero value until both G and P channels go to Unassigned)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PIPD</name>
                <description>Pull down enable</description>
                <bitOffset>16</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_PULL_DOWN</name>
                    <description>No pull down</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PULL_DOWN</name>
                    <description>Pull down</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>PIPU</name>
                <description>Pull up enable</description>
                <bitOffset>17</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NO_PULL_UP</name>
                    <description>No pull up</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PULL_UP</name>
                    <description>Pull up</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>INENA</name>
                <description>Input enable</description>
                <bitOffset>18</bitOffset>
                <bitWidth>1</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>INP_DISABLE</name>
                    <description>Inputs 0 to connected core</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INP_ENABLE</name>
                    <description>Inputs IO pad value to connected core</description>
                    <value>0x1</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
