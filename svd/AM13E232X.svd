                <name>CPSVAL</name>
                <description>Current Prescale Count Value</description>
                <bitOffset>0</bitOffset>
                <bitWidth>8</bitWidth>
                <access>read-only</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>MINIMUM</name>
