              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Ecap_cap_event3_rise</name>
                  <description>Capture Event 3 triggered on a rising edge (RE)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
