                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ecap_write_TSCTR</name>
                  <description>Writing a one forces a TSCTR shadow load of current ECAP module and any ECAP modules down-stream providing the SYNCO_SEL bits are 0,0. After writing a 1, this bit returns to a zero.</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>CAP_APWM</name>
              <description>CAP/APWM operating mode select</description>
              <bitOffset>9</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>Ecap_module</name>
                  <description>ECAP module operates in capture mode. This mode forces the following configuration: #br#- Inhibits TSCTR resets via CTR = PRD event #br#- Inhibits shadow loads on CAP1 and 2 registers #br#- Permits user to enable CAP1-4 register load #br#- CAPx/APWMx pin operates as a capture input</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>Ecap_module_APWM</name>
                  <description>ECAP module operates in APWM mode. This mode forces the following configuration: #br#- Resets TSCTR on CTR = PRD event (period boundary #br#- Permits shadow loading on CAP1 and 2 registers #br#- Disables loading of time-stamps into CAP1-4 registers #br#- CAPx/APWMx pin operates as a APWM output</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
