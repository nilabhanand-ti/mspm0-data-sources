        <register>
          <name>DMAPRIO</name>
          <description>DMA Channel Priority Control</description>
          <addressOffset>0x1100</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>ROUNDROBIN</name>
              <description>Round robin. This bit enables the round-robin DMA channel priorities.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Roundrobin priority disabled, DMA channel priority is fixed: DMA0-DMA1-DMA2-...-DMA16</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Roundrobin priority enabled, DMA channel priority changes with each transfer</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>BURSTSZ</name>
              <description>Define the burst size of a block transfer, before the priority is re-evaluated</description>
              <bitOffset>16</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>INFINITI</name>
                  <description>There is no burst size, the whole block transfer is completed on one transfer without interruption</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURST_8</name>
                  <description>The burst size is 8, after 9 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BUSRT_16</name>
                  <description>The burst size is 16, after 17 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BURST_32</name>
                  <description>The burst size is 32, after 33 transfers the block transfer is interrupted and the priority is reevaluated</description>
                  <value>0x3</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
