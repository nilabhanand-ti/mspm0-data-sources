                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCD1</name>
                    <description>Selects CCD from CC1.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCD2</name>
                    <description>Selects CCD from CC2.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCD3</name>
                    <description>Selects CCD from CC3.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCD4</name>
                    <description>Selects CCD from CC4.</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>SEL_CCD5</name>
                    <description>Selects CCD from CC5.</description>
                    <value>0x5</value>
                  </enumeratedValue>
