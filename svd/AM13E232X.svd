        </register>
        <register>
          <name>SYSOSCCFG</name>
          <description>SYSOSC configuration</description>
          <addressOffset>0x1100</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>BLOCKASYNCALL</name>
              <description>BLOCKASYNCALL may be used to mask block all asynchronous fast clock requests, preventing hardware from dynamically changing the active clock configuration when operating in a given mode.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Asynchronous fast clock requests are controlled by the requesting peripheral</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>All asynchronous fast clock requests are blocked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>DISABLE</name>
              <description>DISABLE sets the SYSOSC enable/disable policy.  SYSOSC may be powered off in RUN, SLEEP, and STOP modes to reduce power consumption.  When SYSOSC is disabled, MCLK and ULPCLK are sourced from LFCLK.</description>
              <bitOffset>10</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Do not disable SYSOSC</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Disable SYSOSC immediately and source MCLK and ULPCLK from LFCLK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FASTCPUEVENT</name>
              <description>if disabled  CPU will not wakeup and continue in STANDBY</description>
              <bitOffset>17</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>An interrupt to the CPU will not assert a fast clock request</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>An interrupt to the CPU will assert a fast clock request</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>FREQ</name>
              <description>Target operating frequency for the system oscillator (SYSOSC)</description>
              <bitOffset>0</bitOffset>
              <bitWidth>2</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSOSCBASE</name>
                  <description>Base frequency (32MHz)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSOSC4M</name>
                  <description>Low frequency (4MHz)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>MCLKCFG</name>
          <description>Main clock (MCLK) configuration</description>
          <addressOffset>0x1104</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>USEHSCLK</name>
              <description>USEHSCLK, together with USELFCLK, sets the MCLK source policy.  Set USEHSCLK to use HSCLK (HFCLK or SYSPLL) as the MCLK source in RUN and SLEEP modes.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>MCLK will not use the high speed clock (HSCLK)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>MCLK will use the high speed clock (HSCLK) in RUN and SLEEP mode</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>USELFCLK</name>
              <description>LFCLK is not an MCLK sourcei in PD1, tied 0.</description>
              <bitOffset>20</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>MCLK will not use the low frequency clock (LFCLK)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>MCLK will use the low frequency clock (LFCLK)</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCLKDIVCFG</name>
              <description>MCLK Divider Configuration bits [1:0] are defined as MCLK4 is Bypass, MCLK2 is Bypass</description>
              <bitOffset>24</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>RATIO_1_1_1</name>
                  <description>MCLK: No Divide, MCLK2: No Divide, MCLK4: No Divide</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RATIO_1_1_2</name>
                  <description>MCLK: No Divide, MCLK2: No Divide, MCLK4: Divide MCLK by 2</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RATIO_1_1_4</name>
                  <description>MCLK: No Divide, MCLK2: No Divide, MCLK4: Divide MCLK by 4</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RATIO_1_2_2</name>
                  <description>MCLK: No Divide, MCLK2: Divide MCLK by 2, MCLK4: Divide MCLK by 2</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>RATIO_1_2_4</name>
                  <description>MCLK: No Divide, MCLK2: Divide MCLK by 2, MCLK4: MCLK by 4</description>
                  <value>0x7</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>STOPCLKSTBY</name>
              <description>STOPCLKSTBY sets the STANDBY mode policy (STANDBY0 or STANDBY1).  When set, ULPCLK and LFCLK are disabled to all peripherals in STANDBY mode, with the exception of TIMG0 and TIMG1 which continue to run.  Wake-up is only possible via an asynchronous fast clock request.</description>
              <bitOffset>21</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>ULPCLK/LFCLK runs to all PD0 peripherals in STANDBY mode</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>ULPCLK/LFCLK is disabled to all peripherals in STANDBY mode except TIMG0 and TIMG1</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>MCLKDEADCHK</name>
              <description>MCLKDEADCHK enables or disables the continuous MCLK dead check monitor.  LFCLK must be running before MCLKDEADCHK is enabled.</description>
              <bitOffset>22</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>The MCLK dead check monitor is disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>The MCLK dead check monitor is enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HSCLKEN</name>
          <description>High-speed clock (HSCLK) source enable/disable</description>
          <addressOffset>0x1108</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>USEEXTHFCLK</name>
              <description>USEEXTHFCLK selects the HFCLK_IN digital clock input to be the source for HFCLK.</description>
              <bitOffset>16</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Use XTAL as the HFCLK source</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Use the HFCLK_IN digital clock input as the HFCLK source</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>SYSPLLEN</name>
              <description>SYSPLLEN enables or disables the system phase-lock loop (SYSPLL).</description>
              <bitOffset>8</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>Disable the SYSPLL</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>Enable the SYSPLL</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HSCLKCFG</name>
          <description>High-speed clock (HSCLK) source selection</description>
          <addressOffset>0x110C</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>HSCLKSEL</name>
              <description>HSCLKSEL selects the HSCLK source (SYSPLL or HFCLK).</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYSPLL</name>
                  <description>HSCLK is sourced from the SYSPLL</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>HFCLKCLK</name>
                  <description>HSCLK is sourced from the HFCLK</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>HFCLKCLKCFG</name>
          <description>High-frequency clock (HFCLK) configuration</description>
          <addressOffset>0x1110</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>XTALTIME</name>
              <description>XTALTIME specifies the XTAL startup time in 64us resolution.  If the HFCLK startup monitor is enabled (HFCLKFLTCHK), XTAL will be checked after this time expires.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>8</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>MINSTARTTIME</name>
                  <description>Minimum startup time (approximatly zero)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>MAXSTARTTIME</name>
                  <description>Maximum startup time (approximatly 16.32ms)</description>
                  <value>0xFF</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>HFCLKFLTCHK</name>
              <description>HFCLKFLTCHK enables or disables the HFCLK startup monitor.</description>
              <bitOffset>28</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>HFCLK startup is not checked</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>HFCLK startup is checked</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSPLLCFG0</name>
          <description>SYSPLL reference and output configuration</description>
          <addressOffset>0x1120</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>ENABLECLK0</name>
              <description>ENABLECLK0 enables or disables the SYSPLLCLK0 output.</description>
              <bitOffset>4</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>SYSPLLCLK0 is disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>SYSPLLCLK0 is enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>ENABLECLK1</name>
              <description>ENABLECLK1 enables or disables the SYSPLLCLK1 output.</description>
              <bitOffset>5</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>DISABLE</name>
                  <description>SYSPLLCLK1 is disabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>ENABLE</name>
                  <description>SYSPLLCLK1 is enabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>RDIVCLK1</name>
              <description>RDIVCLK1 sets the final divider for the SYSPLLCLK1 output.</description>
              <bitOffset>12</bitOffset>
              <bitWidth>4</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>CLK1DIV2</name>
                  <description>SYSPLLCLK1 is divided by 2</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CLK1DIV4</name>
                  <description>SYSPLLCLK1 is divided by 4</description>
                  <value>0x1</value>
