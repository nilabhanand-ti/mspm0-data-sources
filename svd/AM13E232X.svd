              </field>
              <field>
                <name>DMADSTWDTH</name>
                <description>DMA destination width. This bit selects the destination as a byte, half word, word, long word or long-long word.</description>
                <bitOffset>12</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>BYTE</name>
                    <description>Destination data width is BYTE (8-bit)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>HALF</name>
                    <description>Destination data width is HALF-WORD (16-bit)</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>WORD</name>
                    <description>Destination data width is WORD (32-bit)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LONG</name>
                    <description>Destination data width is LONG-WORD (64-bit)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>LONGLONG</name>
                    <description>Source data width is LONG-LONG-WORD (128-bit)</description>
                    <value>0x4</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMASRCINCR</name>
                <description>DMA source increment. This bit selects automatic incrementing or decrementing of the source address DMASA for each transfer. The amount of change to the DMASA is based on the definitin in the DMASRCWDTH. For example an increment of 1 (+1) on a WORD transfer will increment the DMASA by 4.</description>
                <bitOffset>16</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNCHANGED</name>
                    <description>Address is unchanged (+0)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DECREMENT</name>
                    <description>Decremented by 1 (-1 * DMASRCWDTH)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INCREMENT</name>
                    <description>Incremented by 1 (+1 * DMASRCWDTH)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_2</name>
                    <description>Stride size 2 (+2 * DMASRCWDTH)</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_3</name>
                    <description>Stride size 3 (+3 * DMASRCWDTH)</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_4</name>
                    <description>Stride size 4 (+4 * DMASRCWDTH)</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_5</name>
                    <description>Stride size 5 (+5 * DMASRCWDTH)</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_6</name>
                    <description>Stride size 6 (+6 * DMASRCWDTH)</description>
                    <value>0xC</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_7</name>
                    <description>Stride size 7 (+7 * DMASRCWDTH)</description>
                    <value>0xD</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_8</name>
                    <description>Stride size 8 (+8 * DMASRCWDTH)</description>
                    <value>0xE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_9</name>
                    <description>Stride size 9 (+9 * DMASRCWDTH)</description>
                    <value>0xF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMADSTINCR</name>
                <description>DMA destination increment. This bit selects automatic incrementing or decrementing of the destination address DMADA for each transfer. The amount of change to the DMADA is based on the definitin in the DMADSTWDTH. For example an increment of 1 (+1) on a WORD transfer will increment the DMADA by 4.</description>
                <bitOffset>20</bitOffset>
                <bitWidth>4</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>UNCHANGED</name>
                    <description>Address is unchanged (+0)</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DECREMENT</name>
                    <description>Decremented by 1 (-1 * DMADSTWDTH)</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>INCREMENT</name>
                    <description>Incremented by 1 (+1 * DMADSTWDTH)</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_2</name>
                    <description>Stride size 2 (+2 * DMADSTWDTH)</description>
                    <value>0x8</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_3</name>
                    <description>Stride size 3 (+3 * DMADSTWDTH)</description>
                    <value>0x9</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_4</name>
                    <description>Stride size 4 (+4 * DMADSTWDTH)</description>
                    <value>0xA</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_5</name>
                    <description>Stride size 5 (+5 * DMADSTWDTH)</description>
                    <value>0xB</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_6</name>
                    <description>Stride size 6 (+6 * DMADSTWDTH)</description>
                    <value>0xC</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_7</name>
                    <description>Stride size 7 (+7 * DMADSTWDTH)</description>
                    <value>0xD</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_8</name>
                    <description>Stride size 8 (+8 * DMADSTWDTH)</description>
                    <value>0xE</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>STRIDE_9</name>
                    <description>Stride size 9 (+9 * DMADSTWDTH)</description>
                    <value>0xF</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMATM</name>
                <description>DMA transfer mode</description>
                <bitOffset>28</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>SINGLE</name>
                    <description>Single transfer. Each transfers requires a new trigger. When the DMASZ counts down to zero an event can be generated and the DMAEN is cleared.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>BLOCK</name>
                    <description>Block transfer. Each trigger transfers the complete block defined in DMASZ. After the transfer is complete an event can be generated and the DMAEN is cleared.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RPTSNGL</name>
                    <description>Repeated single transfer. Each transfers requires a new trigger. When the DMASZ counts down to zero an event can be generated. After the last transfer the DMASA, DMADA, DAMSZ registers are restored to its initial value and the DMAEN stays enabled.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>RPTBLCK</name>
                    <description>Repeated block transfer. Each trigger transfers the complete block defined in DMASZ. After the last transfer the DMASA, DMADA, DAMSZ registers are restored to its initial value and the DMAEN stays enabled.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAEM</name>
                <description>DMA Extended Mode</description>
                <bitOffset>24</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>NORMAL</name>
                    <description>Normal mode is related to transfers from SRC to DST</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>GATHERMODE</name>
                    <description>Gather mode will read a data from an address table located at SA, and the data is transfered to the DA</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>FILLMODE</name>
                    <description>Fill mode will copy the SA register content as data to DA</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>TABLEMODE</name>
                    <description>Table mode will read an address and data value from SA and write the data to address</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAPREIRQ</name>
                <description>Enable an early IRQ event. This can help software to react quicker to and DMA done event or allows some additional configuration before the channel is complete.     Note: This register is only available in a FULL-channel configuration. Please consult the datasheet of the specific device to map which channel number has FULL or BASIC capability. In a BASIC configuration this register is a read only value and always reads as 0x0.</description>
                <bitOffset>4</bitOffset>
                <bitWidth>3</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>PREIRQ_DISABLE</name>
                    <description>Pre-IRQ event disabled.</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_1</name>
                    <description>Issure Pre-IRQ event when DMASZ=1</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_2</name>
                    <description>Issure Pre-IRQ event when DMASZ=2</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_4</name>
                    <description>Issure Pre-IRQ event when DMASZ=4</description>
                    <value>0x3</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_8</name>
                    <description>Issure Pre-IRQ event when DMASZ=8</description>
                    <value>0x4</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_32</name>
                    <description>Issure Pre-IRQ event when DMASZ=32</description>
                    <value>0x5</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_64</name>
                    <description>Issure Pre-IRQ event when DMASZ=64</description>
                    <value>0x6</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>PREIRQ_HALF</name>
                    <description>Issure Pre-IRQ event when DMASZ reached the half size point of the original transfer size</description>
                    <value>0x7</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
              <field>
                <name>DMAAUTOEN</name>
                <description>Automatic DMA channel enable on DMASA, DMADA, DMASZ register write.  If channel is configured as SW trigger (DMATCTL=0), the AUTOEN will set the DMAEN and DMAREQ.  If channel is configured as HW trigger (DMACTL!=0), the AUTOEN will only set the DMAEN.</description>
                <bitOffset>2</bitOffset>
                <bitWidth>2</bitWidth>
                <access>read-write</access>
                <enumeratedValues>
                  <enumeratedValue>
                    <name>DISABLE</name>
                    <description>No automatic DMA enable</description>
                    <value>0x0</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DMASA</name>
                    <description>Automatic DMA enable on DMASA register write.</description>
                    <value>0x1</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DMADA</name>
                    <description>Automatic DMA enable on DMADA register write.</description>
                    <value>0x2</value>
                  </enumeratedValue>
                  <enumeratedValue>
                    <name>DMASZ</name>
                    <description>Automatic DMA enable on DMASZ register write.</description>
                    <value>0x3</value>
                  </enumeratedValue>
                </enumeratedValues>
              </field>
            </fields>
          </register>
          <register>
            <name>DMASA</name>
            <description>DMA Channel Source Address</description>
            <addressOffset>0x4</addressOffset>
            <size>32</size>
            <fields>
              <field>
                <name>ADDR</name>
