        <register>
          <name>RSTCAUSE</name>
          <description>Reset cause</description>
          <addressOffset>0x1220</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>ID</name>
              <description>ID is a read-to-clear field which indicates the lowest level reset cause since the last read.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>5</bitWidth>
              <access>read-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>NORST</name>
                  <description>No reset since last read</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORHWFAIL</name>
                  <description>POR- violation, SHUTDNSTOREx or PMU trim parity fault</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POREXNRST</name>
                  <description>NRST triggered POR (&gt;1s hold)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>PORSW</name>
                  <description>Software triggered POR</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORSUPPLY</name>
                  <description>BOR0- violation</description>
                  <value>0x4</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BORWAKESHUTDN</name>
                  <description>SHUTDOWN mode exit</description>
                  <value>0x5</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTNONPMUPARITY</name>
                  <description>Non-PMU trim parity fault</description>
                  <value>0x8</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTCLKFAIL</name>
                  <description>Fatal clock failure</description>
                  <value>0x9</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTEXNRST</name>
                  <description>NRST triggered BOOTRST (&lt;1s hold)</description>
                  <value>0xC</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTSW</name>
                  <description>Software triggered BOOTRST</description>
                  <value>0xD</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTWWDT0</name>
                  <description>WWDT0 violation</description>
                  <value>0xE</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSBSLEXIT</name>
                  <description>BSL exit</description>
                  <value>0x10</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSBSLENTRY</name>
                  <description>BSL entry</description>
                  <value>0x11</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSFLASHECC</name>
                  <description>Flash uncorrectable ECC error</description>
                  <value>0x14</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSCPULOCK</name>
                  <description>CPULOCK violation</description>
                  <value>0x15</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSDBG</name>
                  <description>Debug triggered SYSRST</description>
                  <value>0x1A</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>SYSSW</name>
                  <description>Software triggered SYSRST</description>
                  <value>0x1B</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CPUDBG</name>
                  <description>Debug triggered CPURST</description>
                  <value>0x1C</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>CPUSW</name>
                  <description>Software triggered CPURST</description>
                  <value>0x1D</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RESETLEVEL</name>
          <description>Reset level for application-triggered reset command</description>
          <addressOffset>0x1300</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>LEVEL</name>
              <description>LEVEL is used to specify the type of reset to be issued when RESETCMD is set to generate a software triggered reset.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>3</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>SYS</name>
                  <description>Issue a SYSRST (CPU plus peripherals only)</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOT</name>
                  <description>Issue a BOOTRST (CPU, peripherals, and boot configuration routine)</description>
                  <value>0x1</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTLOADERENTRY</name>
                  <description>Issue a SYSRST and enter the boot strap loader (BSL)</description>
                  <value>0x2</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>POR</name>
                  <description>Issue a power-on reset (POR)</description>
                  <value>0x3</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>BOOTLOADEREXIT</name>
                  <description>Issue a SYSRST and exit the boot strap loader (BSL)</description>
                  <value>0x4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>RESETCMD</name>
          <description>Execute an application-triggered reset command</description>
          <addressOffset>0x1304</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>GO</name>
              <description>Execute the reset specified in RESETLEVEL.LEVEL.  Must be written together with the KEY.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Issue reset</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0xE4</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSOSCFCLCTL</name>
          <description>SYSOSC frequency correction loop (FCL) ROSC enable</description>
          <addressOffset>0x1310</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>SETUSEFCL</name>
              <description>Set SETUSEFCL to enable the frequency correction loop in SYSOSC.  Once enabled, this state is locked until the next BOOTRST.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Enable the SYSOSC FCL</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0x2A</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SHDNIOREL</name>
