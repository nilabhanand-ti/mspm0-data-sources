            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0x91</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>EXRSTPIN</name>
          <description>Disable the reset function of the NRST pin</description>
          <addressOffset>0x1320</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>DISABLE</name>
              <description>Set DISABLE to disable the reset function of the NRST pin.  Once set, this configuration is locked until the next POR.</description>
              <bitOffset>0</bitOffset>
              <bitWidth>1</bitWidth>
              <access>read-write</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>FALSE</name>
                  <description>Reset function of NRST pin is enabled</description>
                  <value>0x0</value>
                </enumeratedValue>
                <enumeratedValue>
                  <name>TRUE</name>
                  <description>Reset function of NRST pin is disabled</description>
                  <value>0x1</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
            <field>
              <name>KEY</name>
              <description>Key which must be written for the write to take effect.</description>
              <bitOffset>24</bitOffset>
              <bitWidth>8</bitWidth>
              <access>write-only</access>
              <enumeratedValues>
                <enumeratedValue>
                  <name>KEY</name>
                  <description>Write key.</description>
                  <value>0x1E</value>
                </enumeratedValue>
              </enumeratedValues>
            </field>
          </fields>
        </register>
        <register>
          <name>SYSSTATUSCLR</name>
          <description>Clear sticky bits of SYSSTATUS</description>
          <addressOffset>0x1324</addressOffset>
          <size>32</size>
          <fields>
            <field>
              <name>ALLECC</name>
